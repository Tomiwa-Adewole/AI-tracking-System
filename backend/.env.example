PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.example.mongodb.net/?appName=Cluster
GEMINI_API_KEY=your_google_gemini_api_key
# Recruiter sign-in (required for ATS endpoints)
RECRUITER_EMAIL=recruiter@example.com
RECRUITER_PASSWORD=replace-with-a-long-unique-password
# Generate a random secret with at least 32 characters; keep it private.
ATS_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional: override the Gemini model configured by the backend.
# GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated frontend origin allow-list for production.
# CORS_ORIGIN=https://your-frontend.example.com

# Optional Gmail status-email support. Use a Google app password if required.
# EMAIL_USER=recruiter@example.com
# EMAIL_PASS=your_google_app_password
